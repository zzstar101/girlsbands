{
  "name": "girlsbands",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "packageManager": "bun@1.4.2",
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "db:migrate": "bun scripts/migrate.ts",
    "dev:api": "bun run --filter @girlsbands/api dev",
    "dev:worker": "bun run --filter @girlsbands/worker dev",
    "dev:web": "bun run --filter @girlsbands/web dev",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && bun run --filter @girlsbands/web typecheck",
    "test": "bun tests/run.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
