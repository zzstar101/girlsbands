# 少女乐队's 的配置。复制成 .env 再改（或者运行 node scripts/init-env.ts，它会生成 .env 并填好随机密钥）。
# 前端只拿到网站地址；所有密钥只在后端。不要把 .env 提交到 Git。

# ===== 必填 =====

# 网站对外的地址：生成的链接、RSS、分享图、MCP 都用它。本机试用就用下面这个。
SITE_URL=http://localhost:3000

# 管理员密码（至少 12 位），登录 /admin 用。
ADMIN_PASSWORD=

# 会话签名和图片代理签名的密钥，各填一串随机字符（可以用 openssl rand -hex 32 生成）。
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 用 Docker 时数据库的密码（数据库不对外开放端口，也请用随机字符）。
POSTGRES_PASSWORD=

# 模型：任何 OpenAI 兼容接口都可以，所有步骤默认都用它。下面是 DeepSeek 的写法。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 服务商特有的请求参数（JSON），比如关掉思考模式：
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 其他服务商的例子：
#   千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   智谱      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash
# 模型能看图就打开（精选内容的标题摘要会参考首图）：
# LLM_VISION=true
# 服务不支持 JSON 模式（response_format）时关掉：
# LLM_JSON_MODE=false

# ===== 选填：让事件归组更准 =====

# 向量召回：任何 OpenAI 兼容的 /embeddings 接口。不填也能跑：归组改用文字重合度找候选，
# 但只作热度证据的讨论帖（hot_signal 信源）大多挂不到事件上，热度会偏低。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 或者只填阿里云百炼的 key，就用 text-embedding-v4：
# DASHSCOPE_API_KEY=
# 向量的维度（用 EMBEDDING_* 时默认取服务返回的，百炼默认 1024）；改了以后旧向量会重新计算：
# EMBEDDING_DIMS=

# ===== 选填：每一步单独换模型 =====
# 默认每一步都用上面的 LLM_*。想让某一步用别家，填预设名（需要对应的 key）：
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# 预设名与需要的 key：
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 这个站的分工（供参考）：
#   PREFILTER_MODEL=qwen3.7-flash  SCORE_MODEL=glm-5.3-flash-selection  UNDERSTAND_MODEL=glm-5.3-flash
#   SUMMARIZE_MODEL=deepseek-flash  STRUCTURE_MODEL=qwen3.8-flash  GROUP_MODEL=deepseek-flash
#   GROUP_REVIEW_MODEL=mimo-v2.6-flash  DIGEST_MODEL=deepseek-flash  REPORT_MODEL=deepseek-flash

# ===== 选填：付费的采集服务（按请求计费，有预算熔断，在后台“设置”里调） =====
# 三家的地址都有默认值，只有自建或走镜像网关时才需要填 *_BASE_URL。
# X（推特）账号：SocialData
# SOCIALDATA_API_KEY=
# SOCIALDATA_BASE_URL=https://api.socialdata.tools
# 微信公众号：极致了（Dajiala）
# DAJIALA_KEY=
# DAJIALA_BASE_URL=https://www.dajiala.com
# 抓不到正文时用浏览器渲染兜底：Jina Reader
# JINA_API_KEY=
# JINA_BASE_URL=https://r.jina.ai
# 读 GitHub 接口类信源时提高配额（只读 token）
# GITHUB_TOKEN=

# ===== 选填：飞书 =====
# 精选推送到飞书群（只推 T1、T1_5 信源的精选）：在后台“设置 → 通知目的地”里启用，webhook 地址填在这里。
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# 告警、反馈转发到内部飞书群（需要一个飞书自建应用）：
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# 用飞书账号登录后台（可选，和管理员密码并存）：
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 选填：邮件订阅 =====

# 读者订阅的邮件（截止提醒、精选摘要）。默认关闭：写成 true 才会连 SMTP 发信。
# SMTP 参数按密钥组存在 integrations 里（GIRLSBANDS_CREDENTIALS_DIR/integrations.env），也可以直接写在这里：
# SMTP_HOST、SMTP_PORT（默认 587）、SMTP_USER、SMTP_PASS、SMTP_SECURE（不填时 465 端口自动为 true）、
# EMAIL_FROM（必填，形如 少女乐队's <no-reply@example.com>）、EMAIL_REPLY_TO。
EMAIL_ENABLED=false
# 走 nodemailer 的 json 传输：整封信生成出来但不投递，用来核对内容和排版。
EMAIL_DRY_RUN=false
# 用哪套模板：cover（封面，默认）——顶上是一张现画的通栏头图，见 docs/subscribe.md。
# EMAIL_STYLE=cover
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# EMAIL_REPLY_TO=

# EdgeOne 流量统计（可选；不配置则不调用腾讯云 API）
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=

# ===== 选填：其他 =====
# 外部脚本往站里推送内容（POST /api/ingest/items）用的 token，至少 16 位；不填就关闭这个接口。
# INGEST_TOKEN=
# 抓取海外信源要走代理时（比如服务器在中国大陆）：
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 个别信源屏蔽了服务器所在机房（例如 hatena 对香港机房回 403）：信源配置写 "relay": true，就经
# Cloudflare Worker 中转（deploy/relay-worker.js，Worker 里设同一个 RELAY_SECRET）。不填就直接抓。
# FETCH_RELAY_URL=https://girlsbands-relay.<子域>.workers.dev/
# FETCH_RELAY_SECRET=
# 前面有 Caddy 或 Nginx 这类反向代理时设为 true，访客地址才从代理的 X-Forwarded-For 里读；
# 网站直接对外时保持 false，免得有人伪造地址绕过登录次数和反馈的限制。
TRUST_PROXY=false
# MCP 只接受发给 SITE_URL 域名（和 localhost）的请求；还有别的访问域名时，逗号分隔写在这里：
# MCP_ALLOWED_HOSTS=
# 网站多久没有新内容就算“停止收录”并告警（分钟，默认 360）：
# ALERT_QUIET_MINUTES=360
# 每天把新页面提交给 IndexNow（Bing 等）；key 是 32 位十六进制，自己生成一个：
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 数据库每天备份到 S3 兼容的对象存储（腾讯云 COS、AWS S3、阿里云 OSS……）：
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# 图片缓存放 S3 兼容的对象存储（Cloudflare R2 等）时，服务器磁盘不再随图片增长；不填就用 .data/imgcache 本地目录：
# IMAGE_STORE_ACCESS_KEY_ID=
# IMAGE_STORE_SECRET_ACCESS_KEY=
# IMAGE_STORE_BUCKET=
# IMAGE_STORE_ENDPOINT=
# IMAGE_STORE_REGION=auto
# 日志级别（默认 info）和数据库连接池上限（默认 10）：
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# 版本名：显示在后台“运行”页和 /api/health，升级后可以确认进程已经换新：
# GIRLSBANDS_RELEASE=
# 环境名，默认按 NODE_ENV 取 production 或 development；不是 production 时告警会带上它，开发免登录也只在非 production 时可用：
# GIRLSBANDS_ENVIRONMENT=
# 把密钥按组写在一个目录里（models.env、collectors.env、integrations.env、auth.env），代替写在这里；这里写了的优先：
# GIRLSBANDS_CREDENTIALS_DIR=

# ===== 安全阀 =====
# 这两个是上线的总开关：写成 true 才会抓信源、才会花钱调模型。默认 false —— 刚部署好的站
# 不会自己动起来。确认站点能打开、管理员能登录、SITE_URL 填对了，再改 true 开始收录。
# 调试界面、排练版式时也保持 false（改完记得重启 api 和 worker 才生效）。
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false

# ===== 不用 Docker、直接在本机跑时才需要 =====
# DATABASE_URL=postgres://用户名@127.0.0.1:5432/girlsbands
# API_BASE_URL=http://127.0.0.1:3001
# 开发时免登录进后台（生产环境会拒绝启动），后台显示的名字：
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# 本机调试时允许抓内网地址（默认禁止，生产环境拒绝启动）：
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== 用 docker compose --profile https 时 =====
# SITE_DOMAIN=example.com
# 只想让本机的 Caddy 访问 web 时，把 3000 收到回环上（默认 3000，直接对外）：
# PORT=127.0.0.1:3000
# Caddy 默认占用宿主机的 80 和 443。这台机器前面还有 CDN 或别的 Web 服务器时，把 Caddy 收进高位
# 端口，再让前面那层转发过来（详见 docs/deploy.md「配域名和 HTTPS」）：
# CADDY_HTTP_PORT=18080
# CADDY_HTTPS_PORT=18443
# 由 EdgeOne 之类的 CDN 终结 TLS、Caddy 只当期源时（详见 docs/deploy.md「前面接 EdgeOne（CDN 终结 TLS）」）：
# 静态资源走这个域名，页面仍在 SITE_URL 上，两个域名指向同一台 web 容器：
# STATIC_DOMAIN=static.example.com
# 带哈希的客户端资源改从静态域名出。只在构建时读，改了要重新 build：
# ASSET_BASE_URL=https://static.example.com
# CDN 回源时带的密钥，对不上的请求直接 403（自签证书，不做 ACME）：
# ORIGIN_AUTH_SECRET=
# 用哪份 Caddyfile，改成 Caddyfile.edgeone 就是上面那套（默认 Caddyfile）：
# CADDYFILE=Caddyfile.edgeone
