{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--filter",
        "@girlsbands/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "apps/api/src/main.ts"
      ],
      "port": 3001
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "apps/web",
        "x",
        "react-router",
        "dev",
        "--port",
        "3017",
        "--host",
        "127.0.0.1"
      ],
      "port": 3017
    },
    {
      "name": "design-sample",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3018",
        "--bind",
        "127.0.0.1",
        "-d",
        ".data/design-sample"
      ],
      "port": 3018
    }
  ]
}