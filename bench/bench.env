# Benchmark-only settings: production mode with every outbound mechanism off, so the stack serves the
# copied data and does nothing else. The secrets exist only inside the throwaway benchmark stack.
NODE_ENV=production
DATABASE_URL=postgres://girlsbands:girlsbands@db:5432/girlsbands
API_BASE_URL=http://api:3001
SITE_URL=http://localhost:3000
GIRLSBANDS_DATA_DIR=/tmp/girlsbands-data
ADMIN_PASSWORD=bench-admin-password-8f3a
SESSION_SECRET=bench-session-secret-1b9c7e2d4f6a8b0c
IMG_PROXY_SIGN_SECRET=bench-img-secret-5d7e9f1a3b5c7d9e
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
EMAIL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
